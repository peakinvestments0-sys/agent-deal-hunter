{
  "manifest_version": 3,
  "name": "407 Flips • Lauren's Redfin Fixer Hunter",
  "version": "1.0.2",
  "description": "1 Click On Market Fixer Scraper for Agent Deal Hunter (Lauren's Trojan Horse Desk)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Push Fixer to Lauren's Desk"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.redfin.com/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*",
    "https://*.407rescreen.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.redfin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.google.com/search*",
        "https://www.google.com/search*"
      ],
      "js": [
        "google_content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
